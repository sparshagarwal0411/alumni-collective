# Supabase Configuration
# For server-side operations (Nitro, edge runtime):
SUPABASE_PROJECT_ID="your_project_id"
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
SUPABASE_URL="https://your_project.supabase.co"

# For client-side operations (Vite React app in browser):
# Variables prefixed with VITE_ are exposed to the frontend
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
VITE_SUPABASE_URL="https://your_project.supabase.co"

# NOTE ON GOOGLE OAUTH:
# You do NOT put your Google Client ID or Secret here in the frontend .env.
# Supabase handles OAuth server-side so credentials remain secure.
# Add your Google Client ID & Secret directly in:
# Supabase Dashboard -> Authentication -> Providers -> Google
